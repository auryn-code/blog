---
import config from '@/site-config'

import { Icon } from '../user'

const footerConf = config.footer
const socialLabels: Record<string, string> = {
  github: 'GitHub',
  telegram: 'Telegram',
  email: 'Email'
}
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='text-muted-foreground'>
        {config.footer.year}
        {config.author}
      </div>

      <div class='flex items-center gap-x-4'>
        {
          footerConf.social &&
            Object.entries(footerConf.social).map(([platform, value]) => {
              const url = typeof value === 'string' ? value : value.url
              const label =
                typeof value === 'string' ? socialLabels[platform] || platform : value.label

              return (
                <a
                  href={url}
                  aria-label={label}
                  target={url.startsWith('mailto:') ? undefined : '_blank'}
                >
                  <Icon name={platform as keyof typeof footerConf.social} />
                </a>
              )
            })
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  footer a:hover {
    color: hsl(var(--primary) / var(--un-text-opacity, 1));
    opacity: 0.9;
  }
</style>
