---
import { cn } from 'astro-pure/utils'

interface Props {
  comment?: boolean
  class?: string
}

const { comment, class: className, ...props } = Astro.props
const path = Astro.url.pathname
---

<div class={cn('text-base text-sm text-muted-foreground', className)} data-path={path} {...props}>
  {
    comment && (
      <a href='#twikoo'>
        <span class='twikoo-comment-count' data-path={path}>-</span> comments
      </a>
    )
  }
</div>

<script>
  import { getCommentsCount } from 'twikoo'
  import config from 'virtual:config'

  function getUniquePaths() {
    const paths = Array.from(document.querySelectorAll('[data-path]'))
      .map(el => el.getAttribute('data-path'))
      .filter(Boolean)

    return [...new Set(paths)]
  }

  function setText(selector, path, value) {
    document.querySelectorAll(selector).forEach(el => {
      if (el.getAttribute('data-path') === path) {
        el.textContent = String(value)
      }
    })
  }

  async function loadCommentCounts() {
    const uniquePaths = getUniquePaths()
    const commentPaths = uniquePaths.filter(path =>
      Array.from(document.querySelectorAll('.twikoo-comment-count')).some(
        el => el.getAttribute('data-path') === path
      )
    )

    if (!commentPaths.length) return

    try {
      const counts = await getCommentsCount({
        envId: config.integ.twikoo.envId,
        region: config.integ.twikoo.region || undefined,
        urls: commentPaths,
        includeReply: false
      })

      for (const item of counts) {
        setText('.twikoo-comment-count', item.url, item.count ?? 0)
      }
    } catch (error) {
      console.debug(`Failed to load comment counts: ${error}`)
    }
  }

  function loadPageStats() {
    loadCommentCounts()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(loadPageStats, 500)
    })
  } else {
    loadPageStats()
  }

  window.addEventListener('twikoo:refresh-stats', loadCommentCounts)
</script>
