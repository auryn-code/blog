---
import { cn } from 'astro-pure/utils'

interface Props {
  comment?: boolean
  class?: string
}

const { comment, class: className, ...props } = Astro.props
const path = Astro.url.pathname
---

<div class={cn('text-base text-sm text-muted-foreground', className)} data-path={path} {...props}>
  <span class='twikoo-pageview-count' data-path={path}>-</span> views
  {
    comment && (
      <>
        {' | '}
        <a href='#twikoo'>
          <span class='twikoo-comment-count' data-path={path}>-</span> comments
        </a>
      </>
    )
  }
</div>

<script>
  // localStorage 方案：每次访问都增加计数
  function loadPageStats() {
    const paths = Array.from(document.querySelectorAll('[data-path]'))
      .map(el => el.getAttribute('data-path'))
      .filter(Boolean)
    
    const uniquePaths = [...new Set(paths)]

    for (const path of uniquePaths) {
      // 1. 记录访问并显示浏览量
      try {
        const key = `twikoo-views-${path}`
        const current = parseInt(localStorage.getItem(key) || '0', 10)
        const newCount = current + 1
        localStorage.setItem(key, String(newCount))

        document.querySelectorAll(`.twikoo-pageview-count[data-path="${path}"]`).forEach(el => {
          el.textContent = String(newCount)
        })
      } catch (error) {
        console.debug(`Failed to record views: ${error}`)
      }

      // 2. 计算评论数（从 DOM 中直接计数）
      try {
        const twikooContainer = document.getElementById('twikoo')
        if (twikooContainer) {
          const commentItems = twikooContainer.querySelectorAll('.tk-comment')
          const commentCount = commentItems.length

          document.querySelectorAll(`.twikoo-comment-count[data-path="${path}"]`).forEach(el => {
            el.textContent = String(commentCount)
          })
        }
      } catch (error) {
        console.debug(`Failed to count comments: ${error}`)
      }
    }
  }

  // 定期更新评论计数（每 500ms 检查一次）
  function updateCommentCount() {
    const paths = Array.from(document.querySelectorAll('[data-path]'))
      .map(el => el.getAttribute('data-path'))
      .filter(Boolean)
    
    const uniquePaths = [...new Set(paths)]

    for (const path of uniquePaths) {
      try {
        const twikooContainer = document.getElementById('twikoo')
        if (twikooContainer) {
          const commentItems = twikooContainer.querySelectorAll('.tk-comment')
          const commentCount = commentItems.length

          document.querySelectorAll(`.twikoo-comment-count[data-path="${path}"]`).forEach(el => {
            el.textContent = String(commentCount)
          })
        }
      } catch (error) {
        console.debug(`Failed to count comments: ${error}`)
      }
    }
  }

  // 页面加载时立即记录访问
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(loadPageStats, 500)
    })
  } else {
    loadPageStats()
  }

  // 定期更新评论计数
  setInterval(updateCommentCount, 500)

  // 监听自定义事件立即更新
  window.addEventListener('twikoo:refresh-stats', loadPageStats)
</script>

