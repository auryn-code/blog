---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'research', text: 'Research' },
  { depth: 2, slug: 'software', text: 'Software' },
  { depth: 2, slug: 'notes', text: 'Notes' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>
    A small collection of interested projects.
  </p>

  <h2 id='tools'>Tools</h2>
  <ProjectSection
    projects={[
      {
        name: 'Calendar Generation',
        description: 'A lunar-solar calendar subscription generator',
        links: [{ type: 'github', href: 'https://github.com/auryn-code/lunar-solar-birthday-calendar-generation' }]
      },
      {
        name: 'Start Page',
        description: 'A simple website startup page',
        links: [{ type: 'github', href: 'https://github.com/auryn-code/aur-startpage'},{ type: 'website', href: 'https://start.aurlabs.co'}]
      }
    ]}
  />
  
</PageLayout>
