---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'research', text: 'Research' },
  { depth: 2, slug: 'software', text: 'Software' },
  { depth: 2, slug: 'notes', text: 'Notes' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>
    A small collection of research ideas, code experiments, and engineering notes. This page is
    intentionally quiet for now; more concrete projects will be added as they become ready to share.
  </p>

  <h2 id='research'>Research</h2>
  <ProjectSection
    projects={[
      {
        name: 'Dynamic Systems and Control',
        description:
          'Research interests around dynamic systems, optimal control, safety control, and reinforcement learning.',
        links: []
      },
      {
        name: 'Distributed Optimal Control',
        description:
          'Exploring scalable control methods for distributed systems and multi-agent coordination.',
        links: []
      }
    ]}
  />

  <h2 id='software'>Software</h2>
  <ProjectSection
    projects={[
      {
        name: 'Personal Website',
        description: 'A personal blog and portfolio built with Astro.',
        links: [{ type: 'github', href: 'https://github.com/auryn-code' }]
      }
    ]}
  />

  <h2 id='notes'>Notes</h2>
  <ProjectSection
    projects={[
      {
        name: 'Research Notes',
        description:
          'Notes on control, learning, programming, and small ideas that are still taking shape.',
        links: [{ type: 'site', href: '/blog' }]
      }
    ]}
  />
</PageLayout>
